{
  "name": "web-access-mcp",
  "version": "1.5.0",
  "description": "Local MCP server for web search (Exa + Tavily with API key rotation), URL content extraction and GitHub search. Zero dependencies.",
  "main": "server.js",
  "bin": {
    "web-access-mcp": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/providers.test.js test/content.test.js test/hardening.test.js test/features.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "exa",
    "tavily",
    "api-key-rotation",
    "github-search"
  ],
  "license": "MIT",
  "files": [
    "*.js",
    ".claude-plugin/",
    ".mcp.json",
    "skills/",
    "web-access.example.json",
    "README.md",
    "README.id.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "author": "mahdyarief",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahdyarief/web-access-mcp.git"
  },
  "homepage": "https://github.com/mahdyarief/web-access-mcp#readme",
  "bugs": {
    "url": "https://github.com/mahdyarief/web-access-mcp/issues"
  }
}
